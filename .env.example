TELEGRAM_BOT_TOKEN=123456789:your_bot_token_here

# Optional
CODEX_BIN=codex
CODEX_MODEL=gpt-5.5
CODEX_SYSTEM_PROMPT=
CODEX_EXTRA_ARGS=
CODEX_WORKDIR=.
CODEX_TIMEOUT_SEC=300
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_EXTRA_ARGS=
CLAUDE_TIMEOUT_SEC=300
CLAUDE_PERMISSION_MODE=acceptEdits
ANTIGRAVITY_BIN=agy
ANTIGRAVITY_EXTRA_ARGS=
ANTIGRAVITY_TIMEOUT_SEC=300
ANTIGRAVITY_APPROVAL_MODE=yolo
ANTIGRAVITY_CLI_TRUST_WORKSPACE=true
ANTIGRAVITY_FORCE_FILE_AUTH=true
# For headless Docker auth path parity (AGY file-token mode)
SSH_CONNECTION=127.0.0.1 0 127.0.0.1 0
REQUEST_DEDUPE_WINDOW_SEC=20
SESSION_IDLE_CLEAR_AFTER_SEC=3600
TELEGRAM_API_TIMEOUT_SEC=30
TELEGRAM_SEND_RETRIES=3
TELEGRAM_SEND_RETRY_DELAY_SEC=1.0
SESSION_DB_PATH=./data/sessions.sqlite3
UPLOAD_DIR=./data/uploads
GENERATED_FILES_DIR=./data/generated
MAX_RETURN_FILES=5
MAX_RETURN_FILE_SIZE_MB=20
ALLOWED_CHAT_IDS=
ALLOWED_USER_IDS=
LOG_LEVEL=INFO
